<?xml version="1.0" encoding="utf-8"?>
<!-- Android-TV home-screen banner (320x180 xhdpi baseline). Black canvas with the
     centred white Snape mark — mirrors the app icon so the launcher tile reads. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/snape_logo" />
</layer-list>
