<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView for the home hero trailer, inflated from XML purely so we can set
  surface_type="texture_view". A TextureView composites like an ordinary view in
  the window (no hole-punched surface, no window relayout when it's added/removed
  or scrolled), unlike PlayerView's default SurfaceView — so the muted hero
  trailer never reintroduces scroll hitching.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom" />
