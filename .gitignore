# ── Monorepo root .gitignore ──────────────────────────────────────────
# Cross-cutting patterns only. Each app carries its own .gitignore:
#   web/.gitignore      (Next.js, Wrangler, PWA, Bun)
#   mobile/.gitignore   (Gradle, Android Studio)
#   desktop/.gitignore  (Electron, electron-builder)

# Dependencies (any app)
node_modules/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*.log
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Stray root build artifacts
*.tsbuildinfo
next-env.d.ts
