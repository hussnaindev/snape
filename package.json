{
  "name": "nextjs-app-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npx wrangler pages dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:cf": "wrangler d1 migrations apply snape-db --remote",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@fullstory/browser": "^2.0.8",
    "@next/third-parties": "^16.2.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^15.3.0",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@libsql/client": "^0.17.3",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/bun": "^1.3.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.4",
    "typescript": "^5",
    "wrangler": "^4.78.0"
  }
}
