# Copy to .env.local and fill in values.
# Never commit .env.local to version control.

# ── TMDB API ─────────────────────────────────────────────
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
