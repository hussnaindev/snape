NEXT_PUBLIC_FULLSTORY_ORG=your_org_id_here

# TMDB API (required)
TMDB_API_KEY=your_tmdb_api_key

# App URL (used for auth cookie security)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for HMAC-signing media-proxy URLs (prevents open-proxy abuse).
# Set to a long random string in production. MUST match the value set on the
# Netlify extraction function.
MEDIA_PROXY_SECRET=change-me-to-a-long-random-string

# URL of the extraction function (runs eat-peach lookups through a residential proxy).
# Local dev — started by `bun run dev` (Node sidecar, not deployed to Cloudflare):
#   NETLIFY_EXTRACT_URL=http://localhost:8787/extract
# Production — Netlify function:
#   NETLIFY_EXTRACT_URL=https://your-site.netlify.app/.netlify/functions/extract
NETLIFY_EXTRACT_URL=

# Residential proxies for extract (required locally via /api/extract and on Netlify).
# Comma/newline-separated host:port:user:pass entries.
PROXY_LIST=

# Set on NETLIFY (the extraction function). Base origin of the standalone media
# proxy Worker (see media-worker/). When set, extract.mjs mints absolute media
# URLs at this origin so video streams off a plain Worker instead of the Next.js
# Pages route — this is what avoids Error 1102 during playback. Leave empty to
# use the in-app /api/media-proxy route (local dev / fallback).
#   MEDIA_PROXY_BASE=https://snape-media.<account>.workers.dev
MEDIA_PROXY_BASE=
