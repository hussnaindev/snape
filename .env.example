# Copy to .env.local and fill in values.
# Never commit .env.local to version control.

# ── App ─────────────────────────────────────────────────
NODE_ENV=development

# Public base URL for cross-origin API calls (leave empty for same-origin)
NEXT_PUBLIC_API_URL=

# ── Auth (example — add your provider) ──────────────────
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# ── Database (example) ───────────────────────────────────
# DATABASE_URL=
