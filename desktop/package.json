{
  "name": "snape-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Snape — minimal macOS desktop app: search & play MovieBox (MVP)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --universal",
    "dist:dir": "electron-builder --mac --universal --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "shaka-player": "^4.11.0"
  },
  "build": {
    "appId": "com.snape.desktop",
    "productName": "Snape",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "node_modules/shaka-player/dist/shaka-player.compiled.js"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ]
    }
  }
}
